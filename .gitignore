# Rust
target/

# Secrets — never commit (.env.example is the committed template)
.env
*.env
.env*
!.env.example
api.token
*.token

# Keys and certificates — never commit
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks
*.keystore
id_rsa*
id_ed25519*
*.asc
.netrc
.pgpass
# Certificate fixtures that tests genuinely need are re-allowed here.
!**/tests/fixtures/**/*.crt

# Databases — the app store holds every message, approval and provider response
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
store.db*
# Compatibility fixtures that tests genuinely need are re-allowed here: the
# DEPS-1 store was written by the pre-bump rusqlite/SQLite and must stay real.
!**/tests/fixtures/**/*.sqlite

# Run logs — tracked QA evidence is already committed; new local logs stay out
*.log

# Git worktrees (parallel builders)
.worktrees/

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# SwiftPM (apps/auxesis-mac): build products and package scratch
apps/auxesis-mac/.build/
apps/auxesis-mac/.swiftpm/
# SwiftPM (packages/AuxesisShared): the shared package is built on its own for
# the iOS check, so it keeps its own scratch beside the sources.
packages/AuxesisShared/.build/
packages/AuxesisShared/.swiftpm/
# make-app.sh assembles the double-clickable bundle here (regenerated)
apps/auxesis-mac/build/

docs/ui-study/shots/
# Owner's reference pack at the repo root only. Anchored: the old unanchored
# `reference/` also hid .claude/skills/chief-of-staff/reference/.
/reference/

# Local git hooks, generated by scripts/install-hooks.sh
.githooks/pre-push

# Third-party licence list, generated by scripts/third-party-licenses.py.
# The copy at the repository root is published and tracked; a copy written
# anywhere else (the app bundle, a build tree) stays ignored.
THIRD-PARTY-LICENSES.txt
!/THIRD-PARTY-LICENSES.txt
